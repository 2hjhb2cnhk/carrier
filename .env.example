# Supabase Dashboard > Project Settings > Data API
SUPABASE_URL=https://your-project-ref.supabase.co

# Browser-safe publishable key only (sb_publishable_...).
# Never use a service_role key, secret key, or database password here.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional server-side weather proxy. Leave blank to use sample weather data.
WEATHER_API_URL=
